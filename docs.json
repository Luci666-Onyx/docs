    "drilldown": true
  },
  "metadata": {
    "timestamp": false
  },
  "styling": {
    "eyebrows": "section",
    "latex": true,
    "codeblocks": "system"
  },
  "banner": {
    "content": "Ootle Live 11/11/2026",
    "dismissible": true,
    "type": "info",
    "color": {
      "dark": "#9906b0"
    }
  },
  "seo": {
    "indexing": "all"
  }
