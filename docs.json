  "appearance": {
    "strict": false,
    "default": "system"
  },
  "background": {
    "decoration": "gradient"
  },
  "description": "Tari is an open, merge-mined digital currency and application platform where anyone can build, own, and exchange value — without permission from a bank, a platform, or a gatekeeper.",
